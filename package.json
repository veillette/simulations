{
  "name": "os-simulations",
  "version": "0.0.0",
  "description": "A collection of web-based simulations from OpenStax",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/npm-install.mjs",
    "dev": "npx http-server . -p 8080 -c-1",
    "dist": "node scripts/dist.mjs",
    "dist:all": "node scripts/dist.mjs --all",
    "deploy": "node scripts/deploy.mjs",
    "npm-install": "node scripts/npm-install.mjs",
    "npm-install:all": "node scripts/npm-install.mjs --all",
    "npm-clean": "node scripts/npm-clean.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/veillette/simulations.git"
  },
  "keywords": [
    "simulation",
    "sim",
    "openstax"
  ],
  "bugs": {
    "url": "https://github.com/veillette/simulations/issues"
  },
  "homepage": "https://github.com/veillette/simulations",
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "http-server": "^14.1.1"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "findup-sync": "^5.0.0",
    "minimatch": "^3.1.4"
  }
}
